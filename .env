NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/school_saas_db?schema=public
JWT_ACCESS_SECRET=super_admin_jwt_access_secret_production_key_12345
JWT_REFRESH_SECRET=super_admin_jwt_refresh_secret_production_key_67890
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REDIS_URL=redis://localhost:6379
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_smtp_user
SMTP_PASSWORD=dummy_smtp_password
# S3 Object Storage Configuration (Railway S3 / AWS S3 / MinIO / Tigris)
AWS_REGION=us-east-1
AWS_S3_BUCKET=school-saas-storage
AWS_ACCESS_KEY_ID=dummy_aws_key
AWS_SECRET_ACCESS_KEY=dummy_aws_secret
# For Railway S3 or custom S3 endpoint, uncomment and configure:
# AWS_ENDPOINT=https://storage.railway.app
# S3_ENDPOINT=https://storage.railway.app
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL=https://your-custom-domain.com
RAZORPAY_KEY_ID=rzp_test_school_saas_sample
RAZORPAY_KEY_SECRET=rzp_test_secret_sample_key
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_sample_key
USE_EMBEDDED_POSTGRES=true
EMBEDDED_POSTGRES_PORT=5433
